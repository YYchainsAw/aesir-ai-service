le="text;html=1;align=left;spacingLeft=12;fontFamily=Consolas;fontSize=14;fontColor=#243E53;" vertex="1" parent="table_access_save_grants"><mxGeometry x="0" y="73" width="480" height="29" as="geometry"/></mxCell><mxCell id="col_access_save_grants_save_id" value="save_id  VARCHAR(36)  PK NN" style="text;html=1;align=left;spacingLeft=12;fontFamily=Consolas;fontSize=14;fontColor=#243E53;" vertex="1" parent="table_access_save_grants"><mxGeometry x="0" y="102" width="480" height="29" as="geometry"/></mxCell><mxCell id="col_access_save_grants_active" value="active  BOOL  NN" style="text;html=1;align=left;spacingLeft=12;fontFamily=Consolas;fontSize=14;fontColor=#243E53;" vertex="1" parent="table_access_save_grants"><mxGeometry x="0" y="131" width="480" height="29" as="geometry"/></mxCell><mxCell id="index_access_save_grants" value="外键索引复用复合主键，无级联删除" style="text;html=1;align=left;spacingLeft=12;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#617487;" vertex="1" parent="table_access_save_grants"><mxGeometry x="0" y="161" width="480" height="33" as="geometry"/></mxCell><mxCell id="fk_access_save_grants" value="1 : 0..*" edge="1" parent="1" source="table_access_players" target="table_access_save_grants" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#357052;strokeWidth=2;dashed=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.4;edgeStyle=entityRelationEdgeStyle;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk_access_credentials" value="1 : 0..*" edge="1" parent="1" source="table_access_players" target="table_access_credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#357052;strokeWidth=2;dashed=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.23;edgeStyle=entityRelationEdgeStyle;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="物理约束&lt;br&gt;• 仅绿色实线为 SQL 外键；access_quotas 无玩家外键。&lt;br&gt;• documents / state_versions / operation_journal 没有互相外键。&lt;br&gt;• BOOL 在 MySQL 落为 TINYINT(1)；active / revoked 无数据库默认。&lt;br&gt;• DOUBLE 时间保存 Unix UTC 秒；额度窗口为 BIGINT 秒。&lt;br&gt;• 当前库排序规则 utf8mb4_0900_ai_ci；metadata 未显式指定。" style="rounded=0;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#F3F6F9;strokeColor=#C9D4DF;fontColor=#3B5368;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1030" height="145" as="geometry"/></mxCell><mxCell id="drift" value="实例偏差（未执行修复）&lt;br&gt;dev 库 expires_at 允许 NULL；源码要求 NN。&lt;br&gt;test / restore 已为 NN；详见数据字典与修复 SQL。&lt;br&gt;本图表达源码 v1，不能代替完整实例一致性审计。" style="rounded=0;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#FFF5EA;strokeColor=#D7A66D;fontColor=#795029;" vertex="1" parent="1"><mxGeometry x="1160" y="1300" width="480" height="185" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>