@startuml 03-core-domain-classes-as-is

' Model: As-Is
' UE baseline: dead903156946ec6956342f02d587612baab1717
' AI service baseline: f548c1ad64c5d284eace084132616d171d45403f
' Evidence: UE-PLAYER-001, UE-ENEMY-001, UE-COMBAT-001,
'           UE-HEALTH-001, UE-POISE-001, UE-COMBAT-STATE-001,
'           UE-TARGETING-001, UE-MATCH-001, UE-ORDER-001,
'           UE-CMD-001, UE-ALICE-BP-001

title Aesir Combat Prototype — 核心领域类图（As-Is）

top to bottom direction

skinparam backgroundColor #FAFAF7
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam ArrowThickness 1.1
skinparam linetype ortho
skinparam nodesep 42
skinparam ranksep 48
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #E8F0FE
  BorderColor #315A93
  FontColor #172554
}
skinparam package {
  BackgroundColor #F7F8FA
  BorderColor #64748B
  FontColor #1E293B
}
skinparam note {
  BackgroundColor #FFF8DB
  BorderColor #9A7B16
  FontColor #3F3308
}

hide empty members

package "A. 权威战斗域" as CombatDomain {
  class "AAesirPlayerCharacter" as Player <<Actor>> {
    -CombatComponent: UAesirCombatComponent [1] {composite}
    -HealthComponent: UAesirHealthComponent [1] {composite}
    -CombatStateComponent: UAesirCombatStateComponent [1] {composite}
    -TargetingComponent: UAesirTargetingComponent [1] {composite}
    --
    +DoMove(Right, Forward)
    +DoLook(Yaw, Pitch)
    -HandleLightAttackInput()
    -HandleHeavyAttackInput()
    -HandleEvadeInput()
    -HandleLockOnInput()
    -HandlePlayerDeath(...)
  }

  class "UAesirTargetingComponent" as Targeting <<ActorComponent>> {
    +ToggleLockOn(): bool
    +FindBestTarget(Radius, MaxAngle): Enemy
    +GetCurrentTarget(): Actor
    +ClearTarget()
  }

  class "AAesirEnemyCharacter" as Enemy <<Actor>> {
    -CombatComponent: UAesirCombatComponent [1] {composite}
    -HealthComponent: UAesirHealthComponent [1] {composite}
    -CombatStateComponent: UAesirCombatStateComponent [1] {composite}
    -PoiseComponent: UAesirPoiseComponent [1] {composite}
    --
    +TryAttack(): bool
    +IsAttacking(): bool
    +IsDead(): bool
    +IsStunned(): bool
    +SetLockOnIndicatorVisible(Visible)
    -HandlePoiseBroken()
    -HandleDeath(...)
  }

  class "UAesirCombatComponent" as Combat <<ActorComponent>> {
    -CurrentAttackType: EAesirAttackType
    +TryLightAttack()
    +TryHeavyAttack()
    +CancelAttack()
    +IsAttacking(): bool
    +IsDamageWindowActive(): bool
    +OnAttackStateChanged(Attacking)
    -PerformAttackTrace(Start, End)
  }

  enum "EAesirAttackType" as AttackType {
    None
    Light
    Heavy
  }

  class "UAesirCombatStateComponent" as CombatState <<ActorComponent>> {
    -CurrentState: EAesirCombatState
    +GetCombatState(): EAesirCombatState
    +SetCombatState(NewState): bool
    +IsInCombatState(State): bool
    +OnCombatStateChanged(Previous, Current)
  }

  enum "EAesirCombatState" as StateType {
    Idle
    Combat
    Attacking
    Evading
    HitReact
    Stunned
    Dead
  }

  class "UAesirHealthComponent" as Health <<ActorComponent>> {
    +GetCurrentHealth(): float
    +GetMaxHealth(): float
    +IsDead(): bool
    +SetInvulnerable(Invulnerable)
    +OnHealthChanged(Current, Max, Delta)
    +OnHitReceived(Location, Causer, Fatal)
    +OnDeath(Instigator, Causer)
  }

  class "UAesirPoiseComponent" as Poise <<ActorComponent>> {
    +ApplyPoiseDamage(Damage): bool
    +ResetPoise()
    +IsBroken(): bool
    +OnPoiseChanged(Current, Max, Delta)
    +OnPoiseBroken()
  }

  Targeting -right-> Enemy : selects / clears
  Combat -right-> AttackType : tracks
  CombatState -right-> StateType : stores

  Player -[hidden]down-> Combat
  Targeting -[hidden]down-> AttackType
  Enemy -[hidden]down-> StateType
  Combat -[hidden]down-> CombatState
  CombatState -[hidden]down-> Health
  Health -[hidden]right-> Poise
}

package "B. 战术订单与服务接入域" as TacticalDomain {
  class "BP_AliceCompanion" as Alice <<Blueprint>> {
    -TacticalOrder: UTacticalOrderComponent [1] {composite}
    +CompanionId = companion.alice
    +EventGraph = EMPTY_GRAPH_VERIFIED
  }

  class "UTacticalOrderComponent" as OrderComponent <<ActorComponent>> {
    -SupportedAbilityIds
    -EncounterActive: bool
    -HasActiveOrder: bool
    -ActiveOrder: FTacticalOrder
    +ValidateOrder(Order): bool
    +BeginEncounter()
    +EndEncounter()
    +TryAcceptOrder(Order): bool
    +ValidateActiveOrderAtTrigger(...): bool
    +CompleteActiveOrder(): bool
    +CancelActiveOrder(Reason): bool
  }

  class "FTacticalOrder" as Order <<Value Object>> {
    +OrderId: string
    +AgentId: string
    +Intent: ETacticalOrderIntent
    +When: FTacticalWhen
    +Then: FTacticalThen
    +Priority: int
    +Expires: FTacticalExpires
  }

  class "UCommandServiceSubsystem" as CommandService <<GameInstanceSubsystem>> {
    +CheckHealth()
    +ParseCommand(Text)
    +ParseVoiceCommand(WavData)
    +ResolveTacticalIntentForTest(..., Context)
    +OnCommandParsed(..., Order)
    +OnTacticalResolved(Success, ResponseJson)
  }

  class "FCombatContext" as Context <<Value Object>> {
    +EncounterId: string
    +SnapshotId: string
    +CapturedAt: string
    +Player: FCombatContextPlayer
    +Companion: FCombatContextCompanion
    +Boss: FCombatContextBoss
  }

  Alice -[hidden]right-> OrderComponent
  OrderComponent *--right Order : active order
  CommandService -[dashed]right-> Context : serializes request
  CommandService -[dashed]up-> Order : parses command response
  Alice -[hidden]down-> CommandService
}

package "C. 战局结果域" as MatchDomain {
  class "AAesirCombatPrototypeGameMode" as GameMode <<GameMode>> {
    -ObservedHealthComponents: UAesirHealthComponent [1..*]
    -RemainingEnemies: int
    -MatchResult: EAesirMatchResult
    -HandlePlayerDeath(...)
    -HandleEnemyDeath(...)
    -FinishCombat(Result)
    #OnCombatEnded(Result)
  }

  enum "EAesirMatchResult" as MatchResult {
    None
    Victory
    Defeat
  }

  GameMode -right-> MatchResult : stores / emits
}

Health -[hidden]down-> Alice
CommandService -[hidden]down-> GameMode

note bottom of CombatDomain
  Actor 对组件的实际拥有关系以 {composite} 类型属性表达，避免重复连线。
  CombatComponent 通过 ApplyPointDamage 影响 Health；目标存在 PoiseComponent 时扣减韧性。
  Montage Notify 控制 ComboWindow 与 AttackWindow。
end note

note bottom of TacticalDomain
  TacticalOrderComponent 已实现校验、优先级替换、触发时复核、完成与取消。
  当前 CommandService → TacticalOrder、TacticalOrder → Alice BT/技能执行均未核验，
  所以不画为 As-Is 关系（GAP-BP-001/002/003）。resolve 当前仍广播 ResponseJson。
end note

note bottom of MatchDomain
  GameMode 在 BeginPlay 订阅玩家和全部敌人的 Health.OnDeath，
  并将最终结果裁定为 Victory 或 Defeat。
end note

legend bottom
  |= 表达方式 |= 含义 |
  | {composite} 类型属性 | Actor/Blueprint 实际拥有的组件；等价表达组合关系 |
  | 实线箭头 | 当前源码中的直接类型关联 |
  | 虚线箭头 | 当前源码中的序列化或响应解析依赖 |
  | 隐藏布局线 | 只约束排版，不表示领域关系 |
endlegend

@enduml
