<mxfile host="Electron" version="29.6.1" type="device" compressed="false"><diagram id="directive-execution" name="指令与回执协作"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="2880" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;UML-15  稳定命令与实际执行回执&lt;/b&gt;" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=30;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1860" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="EVO-20261021 目标协作｜持久幂等、事务确认和条件触发需两端实现；云端建议不裁定UE世界。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1860" height="72" as="geometry"/></mxCell><mxCell id="ue" value="&lt;b&gt;UE 请求 / 同步边界&lt;/b&gt;" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#eef3f8;align=center;verticalAlign=middle;spacing=6;fontSize=19;" vertex="1" parent="1"><mxGeometry x="25" y="190" width="290" height="76" as="geometry"/></mxCell><mxCell id="ue_line" value="" style="html=1;strokeColor=#94a3b8;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="266" as="sourcePoint"/><mxPoint x="170" y="2500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="svc" value="&lt;b&gt;认证 / NPC 编排&lt;/b&gt;" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#eef3f8;align=center;verticalAlign=middle;spacing=6;fontSize=19;" vertex="1" parent="1"><mxGeometry x="455" y="190" width="290" height="76" as="geometry"/></mxCell><mxCell id="svc_line" value="" style="html=1;strokeColor=#94a3b8;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="266" as="sourcePoint"/><mxPoint x="600" y="2500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="exe" value="&lt;b&gt;UE 条件 / GAS 执行&lt;/b&gt;" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#eef3f8;align=center;verticalAlign=middle;spacing=6;fontSize=19;" vertex="1" parent="1"><mxGeometry x="895" y="190" width="290" height="76" as="geometry"/></mxCell><mxCell id="exe_line" value="" style="html=1;strokeColor=#94a3b8;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="266" as="sourcePoint"/><mxPoint x="1040" y="2500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="db" value="&lt;b&gt;持久命令 / 回执仓储&lt;/b&gt;" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#eef3f8;align=center;verticalAlign=middle;spacing=6;fontSize=19;" vertex="1" parent="1"><mxGeometry x="1480" y="190" width="320" height="76" as="geometry"/></mxCell><mxCell id="db_line" value="" style="html=1;strokeColor=#94a3b8;strokeWidth=1.2;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="266" as="sourcePoint"/><mxPoint x="1640" y="2500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="1  凭据、原作用域、逻辑请求ID、当前快照" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="345" as="sourcePoint"/><mxPoint x="600" y="345" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="2  验证归属；原子查询/占位逻辑键与内容摘要" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="435" as="sourcePoint"/><mxPoint x="1640" y="435" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="dedup" value="" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="495" width="1850" height="160" as="geometry"/></mxCell><mxCell id="dedup_tab" value="break" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;shape=parallelogram;fillColor=#eef3f8;spacing=4;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="495" width="84" height="36" as="geometry"/></mxCell><mxCell id="dguard" value="[已处理：同键同内容；回放后结束本次处理]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="500" width="1640" height="35" as="geometry"/></mxCell><mxCell id="e3" value="回放原命令 / 结果；不创建新指令身份" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="595" as="sourcePoint"/><mxPoint x="170" y="595" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="3  首次处理者生成建议；事务保存稳定结果" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="950" as="sourcePoint"/><mxPoint x="1640" y="950" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="持久提交确认（落库后回包前崩溃可重试回放）" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="1030" as="sourcePoint"/><mxPoint x="600" y="1030" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="4  none/澄清 或 原稳定directive" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="1110" as="sourcePoint"/><mxPoint x="170" y="1110" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="has" value="" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="1150" width="1850" height="1090" as="geometry"/></mxCell><mxCell id="has_tab" value="opt" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;shape=parallelogram;fillColor=#eef3f8;spacing=4;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="1150" width="84" height="36" as="geometry"/></mxCell><mxCell id="hasguard" value="[有directive：UE只对当前作用域首次合法命令登记]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="1155" width="1640" height="40" as="geometry"/></mxCell><mxCell id="e8" value="5  校验命令/遭遇/目标/授权/TTL并执行去重" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1260" as="sourcePoint"/><mxPoint x="1040" y="1260" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="accepted 或真实拒绝/过期；接受不等于完成" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="1350" as="sourcePoint"/><mxPoint x="170" y="1350" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="condition" value="" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="220" y="1410" width="1620" height="230" as="geometry"/></mxCell><mxCell id="condition_tab" value="opt" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;shape=parallelogram;fillColor=#eef3f8;spacing=4;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="220" y="1410" width="84" height="36" as="geometry"/></mxCell><mxCell id="condguard" value="[条件指令已接受：只在本地等待当前遭遇条件]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1415" width="1470" height="38" as="geometry"/></mxCell><mxCell id="local" value="UE本地监听；断网不终止有效条件。触发时再次检查目标、状态、冷却、TTL与GAS。&lt;br&gt;目标死亡 / 新遭遇 / 过期：失效，不启动；优先级不绕过不可打断窗口。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="1480" width="1010" height="105" as="geometry"/></mxCell><mxCell id="e10" value="6  实际执行 / 拒绝 / 取消 / 过期结果" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="1740" as="sourcePoint"/><mxPoint x="170" y="1740" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="7  原命令身份 + 实际阶段/结果 + 稳定回执ID" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1840" as="sourcePoint"/><mxPoint x="1640" y="1840" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="apply" value="仓储按作用域去重与合并；重复/乱序不得倒退或重复终结。仅真实结果进入事实/关系。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="1910" width="990" height="65" as="geometry"/></mxCell><mxCell id="e12" value="8  事务确认 + 版本 / 游标" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="2030" as="sourcePoint"/><mxPoint x="170" y="2030" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="ack" value="UE收到持久确认才移除本地待同步项；丢确认或两端重启重传同一身份，不生成新动作。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="2100" width="1500" height="65" as="geometry"/></mxCell><mxCell id="stale" value="" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="2290" width="1850" height="165" as="geometry"/></mxCell><mxCell id="stale_tab" value="opt" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;shape=parallelogram;fillColor=#eef3f8;spacing=4;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="2290" width="84" height="36" as="geometry"/></mxCell><mxCell id="staleguard" value="[读档 / 终局 / 重试 / 旧代或迟到响应]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="2295" width="1680" height="40" as="geometry"/></mxCell><mxCell id="staletext" value="旧请求不能更新当前UI/动作；已确认旧局事实仅归档原scope。重连不重放旧聊天/音频/心跳或动作。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="2365" width="1610" height="55" as="geometry"/></mxCell><mxCell id="limits" value="&lt;b&gt;当前协议与目标分开&lt;/b&gt;&lt;br&gt;同逻辑键处理中重试只等待或返回处理中；不另授执行权。&lt;br&gt;现回执结果：accepted / executed / rejected / expired / cancelled；directiveId到orderId和阶段/终态仍需版本化对齐。&lt;br&gt;启动、命中、完成仅按实际发生反馈；不是本图新增当前schema的started/hit/completed枚举。&lt;br&gt;当前服务仅追加JSONL，事件去重为有限进程缓存；持久命令、事务确认、取消、游标与乱序合并均为本次目标。&lt;br&gt;来源：UC-02/04/05/06，D2/G3/G4/C1～C3，AT-EVO-07/09。实线=请求；虚线消息=返回。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=19;" vertex="1" parent="1"><mxGeometry x="45" y="2580" width="1850" height="225" as="geometry"/></mxCell><mxCell id="conflict" value="" style="html=1;fillColor=none;strokeColor=#64748b;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="45" y="695" width="1850" height="145" as="geometry"/></mxCell><mxCell id="conflict_tab" value="break" style="html=1;shape=parallelogram;fontFamily=Microsoft YaHei;fontSize=18;fillColor=#eef3f8;strokeColor=#64748b;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="695" width="84" height="36" as="geometry"/></mxCell><mxCell id="conflict_guard" value="[同键异内容：冲突拒绝并结束本次处理]" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;" vertex="1" parent="1"><mxGeometry x="155" y="700" width="1640" height="40" as="geometry"/></mxCell><mxCell id="conflict_return" value="显式冲突；不生成建议" style="html=1;fontFamily=Microsoft YaHei;fontSize=19;strokeColor=#475569;strokeWidth=1.5;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="795" as="sourcePoint"/><mxPoint x="170" y="795" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="not_found" value="首次占位成功：持有本轮处理权" style="html=1;fontFamily=Microsoft YaHei;fontSize=19;strokeColor=#475569;strokeWidth=1.5;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="870" as="sourcePoint"/><mxPoint x="600" y="870" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>