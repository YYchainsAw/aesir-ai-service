<mxfile host="Electron" version="29.6.1" type="device" compressed="false"><diagram id="domain" name="领域对象"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="2310" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;UML-12a  NPC 服务领域对象&lt;/b&gt;" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=30;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1760" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="EVO-20261021 目标分析｜身份、来源、生命周期与持久一致性。分析职责不要求逐个生成同名实现类。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1760" height="72" as="geometry"/></mxCell><mxCell id="scope" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;InteractionScope 交互作用域&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;认证主体 / game / saveBranch / character&lt;br&gt;session / encounter 按生命周期关联&lt;hr&gt;+ 验证归属并隔离可变状态&lt;br&gt;+ 不接受自报ID代替认证" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="650" y="200" width="490" height="275" as="geometry"/></mxCell><mxCell id="profile" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CompanionProfile 共享只读配置&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;gameId / companionId / version&lt;br&gt;人格核心 / 表现白名单 / 能力档案&lt;hr&gt;+ 多个作用域复用同一配置&lt;br&gt;+ 输入不能改写人格核心" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1300" y="200" width="490" height="275" as="geometry"/></mxCell><mxCell id="scope_profile" value="采用配置" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scope" target="profile"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="memory" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;MemoryEntry 记忆条目&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / entryId / tier / content&lt;br&gt;sourceId / occurredAt / confirmation&lt;br&gt;revision / resetGeneration&lt;hr&gt;+ 有来源的读取、更新与遗忘" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="650" width="490" height="275" as="geometry"/></mxCell><mxCell id="relation" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;RelationshipState 私有关系&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / value ∈ [0,100] / stage&lt;br&gt;cooldowns / dailyPositive / eventKeys&lt;hr&gt;+ 规则计分、冷却与日上限&lt;br&gt;+ memory/reset 保留本状态" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="490" height="275" as="geometry"/></mxCell><mxCell id="turn" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;InteractionTurn 交互轮次&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / turnKey / contextRevision&lt;br&gt;requestAttempts / status / toolRounds&lt;hr&gt;+ 排队、取消与一次终态提交&lt;br&gt;+ 生成完成 ≠ 播放完成" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1300" y="650" width="490" height="275" as="geometry"/></mxCell><mxCell id="scope_mem" value="私有记忆" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scope" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="scope_rel" value="私有关系" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scope" target="relation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="scope_turn" value="轮次归属" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scope" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="snapshot" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;WorldSnapshot 只读值&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / snapshotId / capturedAt&lt;br&gt;scene / allowed targets / abilities&lt;hr&gt;+ 上下文快照不裁定世界变化&lt;br&gt;+ 当前世界由UE再次复核" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="1080" width="490" height="275" as="geometry"/></mxCell><mxCell id="command" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CommandResult 持久命令结果&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / logicalKey / payloadDigest&lt;br&gt;directiveId ↔ orderId / status&lt;hr&gt;+ 同请求重试回放原结果&lt;br&gt;+ 合并回执、终态不倒退" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="650" y="1080" width="490" height="275" as="geometry"/></mxCell><mxCell id="receipt" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ExecutionReceipt 事实记录&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / executionKey / result&lt;br&gt;encounter / sequence / observedAt&lt;hr&gt;+ 只陈述UE实际反馈&lt;br&gt;+ 持久确认后才移除待同步项" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1300" y="1080" width="490" height="275" as="geometry"/></mxCell><mxCell id="turn_cmd" value="产生 / 复用" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="turn" target="command"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="receipt_command" value="真实反馈" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="receipt" target="command"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="event" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;WorldEvent 真实输入&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope / eventId / type / occurredAt&lt;br&gt;originalEncounter / saveGeneration&lt;hr&gt;+ 持久幂等与来源追踪&lt;br&gt;+ 旧局事实仅归档原作用域" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="1510" width="490" height="275" as="geometry"/></mxCell><mxCell id="directive" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Directive 建议内容&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;type / domain / target / parameters&lt;br&gt;condition / priority / expires&lt;br&gt;abilityRefs: collection&lt;hr&gt;+ 建议、条件与有效期可校验" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="650" y="1510" width="490" height="275" as="geometry"/></mxCell><mxCell id="ability" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AbilitySpec 注册条目&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;game / character / abilityId&lt;br&gt;allowedDomains / runtimeConstraints&lt;hr&gt;+ 施法须引用获准能力&lt;br&gt;+ UE/GAS有最终否决权" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1300" y="1510" width="490" height="275" as="geometry"/></mxCell><mxCell id="snapshot_dir" value="当前标识依据" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="directive" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmd_dir" value="持有建议" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="command" target="directive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dir_ability" value="条件引用" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="directive" target="ability"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="event_cmd" value="触发依据" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="directive" target="event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="limits" value="&lt;b&gt;约束与当前差距&lt;/b&gt;&lt;br&gt;记忆、关系、会话及执行记录属于认证作用域；共享人格不共享玩家状态。普通关联不推导级联删除。&lt;br&gt;记忆reset只清目标会话/长期记忆，并增加重置世代；保留人格、关系及独立信号/回执日志。&lt;br&gt;普通非施法指令可无技能；施法必须引用获准能力，具体每条数量待定。&lt;br&gt;当前仅追加回执JSONL；持久命令、事务确认与乱序合并是待实现目标。现枚举 accepted/executed/rejected/expired/cancelled 不等于已支持 started/hit/completed。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="1920" width="1740" height="235" as="geometry"/></mxCell><mxCell id="footer" value="来源：UC-01～07；D1/D3/G4/M1～M4/C1～C3；BR-DEP-01～06。实线=结构关联，虚线开放箭头=使用或触发依赖。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="2190" width="1740" height="70" as="geometry"/>