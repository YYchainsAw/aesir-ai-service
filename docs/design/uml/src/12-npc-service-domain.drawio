<mxfile host="Electron" version="29.6.1" type="device" compressed="false"><diagram id="domain" name="领域对象"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1880" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0"></mxCell><mxCell id="1" parent="0"></mxCell><mxCell id="title" value="UML-12a  NPC 服务领域对象" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#172235;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1430" height="50"></mxGeometry></mxCell><mxCell id="subtitle" value="分析层：身份、职责和约束｜不要求这些角色逐个生成Python新类；跨对象规则由协作分工承担。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#48566a;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1430" height="66"></mxGeometry></mxCell><mxCell id="profile" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CompanionProfile&lt;/b&gt;&lt;br&gt;«实体»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;gameId / companionId / version&lt;br&gt;人格核心与表现白名单&lt;hr&gt;+ 提供已登记角色配置&lt;br&gt;+ 拒绝交互输入改写核心&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="180" width="330" height="230"></mxGeometry></mxCell><mxCell id="memory" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;MemoryEntry&lt;/b&gt;&lt;br&gt;«实体»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;entryId / tier / content&lt;br&gt;importance / source / timestamps&lt;hr&gt;+ 保持来源及事实可追溯&lt;br&gt;+ 提供条目保留等级依据&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="520" width="350" height="250"></mxGeometry></mxCell><mxCell id="relation" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;RelationshipState&lt;/b&gt;&lt;br&gt;«实体»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;value ∈ [0,100] / stage&lt;br&gt;day / dailyPositive / cooldowns&lt;hr&gt;+ applyEvent(type, at)&lt;br&gt;+ 保护冷却与正向日上限&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="520" width="350" height="250"></mxGeometry></mxCell><mxCell id="owns_memory" value="角色隔离归属" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="profile" target="memory"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="owns_relation" value="当前单玩家关系" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="profile" target="relation"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="m_profile" value="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="400" width="72" height="30"></mxGeometry></mxCell><mxCell id="m_mem" value="0..*" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="500" width="72" height="30"></mxGeometry></mxCell><mxCell id="r_profile" value="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="400" width="72" height="30"></mxGeometry></mxCell><mxCell id="r_rel" value="0..1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1040" y="500" width="72" height="30"></mxGeometry></mxCell><mxCell id="life_note" value="&lt;b&gt;归属与操作范围不同&lt;/b&gt;&lt;br&gt;记忆与关系按游戏/角色隔离。&lt;br&gt;memory/reset清会话与长期记忆，&lt;b&gt;不改人格、不清关系&lt;/b&gt;。&lt;br&gt;普通关联不推导删除角色时的自动级联。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="520" width="430" height="220"></mxGeometry></mxCell><mxCell id="snapshot" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;WorldSnapshot&lt;/b&gt;&lt;br&gt;«值对象»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;snapshotId / scene / time&lt;br&gt;角色、目标和能力的只读上下文&lt;hr&gt;只陈述UE快照，不裁定世界变化&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1010" width="350" height="225"></mxGeometry></mxCell><mxCell id="directive" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Directive&lt;/b&gt;&lt;br&gt;«值对象»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;directiveId / agentId / domain&lt;br&gt;actionType / priority / expires&lt;br&gt;source / rationale / payload&lt;hr&gt;只引用获准标识；接受UE否决&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="1010" width="350" height="265"></mxGeometry></mxCell><mxCell id="ability" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AbilitySpec&lt;/b&gt;&lt;br&gt;«注册条目»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;abilityId / allowedDomains&lt;br&gt;角色授权与可用性条件&lt;hr&gt;提供当前能力约束依据&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="1010" width="350" height="225"></mxGeometry></mxCell><mxCell id="snapshot_input" value="合法标识依据" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="directive" target="snapshot"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="uses_ability" value="条件引用" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="directive" target="ability"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="d_n" value="0..*" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="1080" width="72" height="30"></mxGeometry></mxCell><mxCell id="a_n" value="0..*" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1035" y="1080" width="72" height="30"></mxGeometry></mxCell><mxCell id="skill_note" value="&lt;b&gt;BR-01：能力条件约束&lt;/b&gt;&lt;br&gt;普通非施法指令可以不引用技能；需要技能时必须引用获准能力。&lt;br&gt;单条最多引用几个技能仍待定；0..*不允许施法绕过授权。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="1300" width="460" height="155"></mxGeometry></mxCell><mxCell id="event" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;WorldEvent&lt;/b&gt;&lt;br&gt;«值对象»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;eventId / type / occurredAt&lt;br&gt;sequence / companionId&lt;hr&gt;事实输入；依作用域幂等处理&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1510" width="350" height="220"></mxGeometry></mxCell><mxCell id="receipt" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ExecutionReceipt&lt;/b&gt;&lt;br&gt;«事实记录»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;orderId / encounterId / result&lt;br&gt;agentId / time / sequence?&lt;hr&gt;只记录UE实际反馈，不反写世界&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="1510" width="350" height="220"></mxGeometry></mxCell><mxCell id="domains" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ActivityDomain&lt;/b&gt;&lt;br&gt;«枚举»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;combat / exploration / camp&lt;br&gt;conversation / idle&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="1510" width="350" height="150"></mxGeometry></mxCell><mxCell id="event_input" value="可追溯触发事实" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="directive" target="event"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="receipt_of" value="对应原指令（需关联键）" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="receipt" target="directive"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="receipt_note" value="&lt;b&gt;当前回执边界&lt;/b&gt;&lt;br&gt;现服务仅追加JSONL；orderId与directiveId等跨版本身份尚需对齐。&lt;br&gt;接收≠完成；乱序合并/执行去重不由这条连线宣称已实现。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="760" width="675" height="165"></mxGeometry></mxCell><mxCell id="footer" value="实线：结构关联及端点多重性；虚线开放箭头：临时使用或事实追踪依赖。动作类别不画成已存在的实体子类。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1790" width="1430" height="55"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="object-example" name="对象实例"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="1050" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0"></mxCell><mxCell id="1" parent="0"></mxCell><mxCell id="title" value="UML-12b  对象实例与条件约束" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#172235;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1390" height="50"></mxGeometry></mxCell><mxCell id="subtitle" value="说明性正例，不是实测快照｜检验日常指令可无技能，以及角色隔离和关系取值。原UML-13并入本页。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#48566a;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1390" height="66"></mxGeometry></mxCell><mxCell id="alice" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;alice : CompanionProfile&lt;/u&gt;&lt;/b&gt;&lt;br&gt;«对象实例»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;gameId = aesir&lt;br&gt;companionId = companion.alice&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="190" width="360" height="155"></mxGeometry></mxCell><mxCell id="rel" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;rel : RelationshipState&lt;/u&gt;&lt;/b&gt;&lt;br&gt;«对象实例»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;value = 26&lt;br&gt;stage = neutral&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="500" width="350" height="155"></mxGeometry></mxCell><mxCell id="mem" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;memory : MemoryEntry&lt;/u&gt;&lt;/b&gt;&lt;br&gt;«对象实例»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;owner = companion.alice&lt;br&gt;source与时间有据可查&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="500" width="350" height="155"></mxGeometry></mxCell><mxCell id="alice_rel" value="该角色的关系" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alice" target="rel"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="alice_mem" value="该角色的记忆" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alice" target="mem"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="snap" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;snap : WorldSnapshot&lt;/u&gt;&lt;/b&gt;&lt;br&gt;«对象实例»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;scene = exploration&lt;br&gt;目标object01在当前快照内&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="760" width="350" height="150"></mxGeometry></mxCell><mxCell id="dir" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;d1 : Directive&lt;/u&gt;&lt;/b&gt;&lt;br&gt;«对象实例»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;actionType = observe&lt;br&gt;targetId = object01&lt;br&gt;不引用AbilitySpec&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="730" width="360" height="200"></mxGeometry></mxCell><mxCell id="snap_dir" value="目标标识依据" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="dir" target="snap"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="checks" value="&lt;b&gt;判定规则&lt;/b&gt;&lt;br&gt;✓ observe是普通观察，本例无需技能。&lt;br&gt;✗ 将alice的同一记忆挂给bruno：违反隔离。&lt;br&gt;✗ rel.value = 130：违反BR-04。&lt;br&gt;✗ 施法未引用获准能力：违反BR-01。&lt;br&gt;&lt;br&gt;本例不决定“施法最多几个技能”。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="735" width="390" height="235"></mxGeometry></mxCell><mxCell id="footer" value="reset清目标记忆后，alice人格与rel关系仍保留。对象链接表达归属，不表示此操作销毁角色。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="970" width="1390" height="45"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>