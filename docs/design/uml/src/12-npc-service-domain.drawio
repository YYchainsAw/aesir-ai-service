try"/></mxCell><mxCell id="profile" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;alice : CompanionProfile&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;gameId = aesir&lt;br&gt;character = companion.alice&lt;br&gt;profileVersion = 示例版本&lt;hr&gt;共享只读人格与能力定义" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="500" height="230" as="geometry"/></mxCell><mxCell id="scopeA" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;A : InteractionScope&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;authenticatedUser = 玩家A&lt;br&gt;save = slot1 / branch = main&lt;br&gt;character = companion.alice" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="500" height="230" as="geometry"/></mxCell><mxCell id="scopeB" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;B : InteractionScope&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;authenticatedUser = 玩家B&lt;br&gt;save = slot1 / branch = main&lt;br&gt;character = companion.alice" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1220" y="555" width="500" height="230" as="geometry"/></mxCell><mxCell id="a_profile" value="采用" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scopeA" target="profile"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b_profile" value="采用" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scopeB" target="profile"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="memA" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;memoryA : MemoryEntry&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;owner = A / resetGeneration = 3&lt;br&gt;sourceId = 已确认UE事件 eA&lt;br&gt;revision = 8 / confirmed" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="500" height="230" as="geometry"/></mxCell><mxCell id="dir" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;d1 : Directive&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;scope = A / logicalKey = cmdA&lt;br&gt;domain = exploration&lt;br&gt;actionType = observe / target = object01&lt;br&gt;abilityRefs = 空（普通观察）" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="640" y="930" width="500" height="230" as="geometry"/></mxCell><mxCell id="memB" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;u&gt;memoryB : MemoryEntry&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;owner = B / resetGeneration = 1&lt;br&gt;sourceId = 玩家B的消息 mB&lt;br&gt;confirmation = 玩家主张" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1220" y="930" width="500" height="230" as="geometry"/></mxCell><mxCell id="a_mem" value="私有归属" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scopeA" target="memA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b_mem" value="私有归属" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scopeB" target="memB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_dir" value="原作用域" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=18;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;edgeStyle=none;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scopeA" target="dir"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;判定规则&lt;/b&gt;&lt;br&gt;✓ 同一共享人格可服务A与B；memoryA只对A可见，关系亦按各自scope保存。&lt;br&gt;✓ observe在当前快照存在object01时可无技能；施法仍须引用获准能力，数量未冻结。&lt;br&gt;✗ 把memoryA挂给B或A另一读档分支；✗ 关系值130；✗ 将NPC自述当作治疗成功事实。&lt;br&gt;清A记忆后只建立A的新重置世代，A人格/关系与B数据保留；A旧代队列不能恢复已清内容。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="1660" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>