ounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="1135" as="sourcePoint"/><mxPoint x="1280" y="1135" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="r8" value="clearedSessions / 失效结果" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="1225" as="sourcePoint"/><mxPoint x="910" y="1225" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="r9" value="5  清该scope长期记忆；保持新屏障" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="1315" as="sourcePoint"/><mxPoint x="1750" y="1315" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="cleanup" value="" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="1380" width="1850" height="385" as="geometry"/></mxCell><mxCell id="cleanup_tab" value="alt" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;shape=parallelogram;fillColor=#eef3f8;spacing=4;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="1380" width="84" height="36" as="geometry"/></mxCell><mxCell id="successguard" value="[长期清理成功]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="1385" width="1680" height="40" as="geometry"/></mxCell><mxCell id="r10" value="实际清理结果 + generation" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1750" y="1475" as="sourcePoint"/><mxPoint x="910" y="1475" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="r11" value="成功 + 实际清理数量 + 新generation" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="1560" as="sourcePoint"/><mxPoint x="170" y="1560" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="sep" value="" style="html=1;strokeColor=#94a3b8;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="1600" as="sourcePoint"/><mxPoint x="1895" y="1600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="failureguard" value="[长期清理失败：屏障与会话可能已处理，返回真实部分状态]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="1605" width="1680" height="40" as="geometry"/></mxCell><mxCell id="r12" value="失败 + 已清会话数；不声称整体回滚" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="1710" as="sourcePoint"/><mxPoint x="170" y="1710" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="old" value="" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="1820" width="1850" height="305" as="geometry"/></mxCell><mxCell id="old_tab" value="opt" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;shape=parallelogram;fillColor=#eef3f8;spacing=4;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="1820" width="84" height="36" as="geometry"/></mxCell><mxCell id="oldguard" value="[并发旧轮次写入 / 离线旧队列 / 重启后重连]" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="1825" width="1680" height="40" as="geometry"/></mxCell><mxCell id="r13" value="6  携带原来源ID及旧generation写入" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1920" as="sourcePoint"/><mxPoint x="1750" y="1920" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="r14" value="校验屏障；旧代记忆写入拒绝，不复活内容" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;fontSize=19;strokeColor=#475569;strokeWidth=1.5;rounded=0;curved=0;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1750" y="2010" as="sourcePoint"/><mxPoint x="170" y="2010" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="mixed" value="混合事实的关系贡献单独确认；不得更换事件ID重计关系，也不得借原局事实触发当前动作。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;spacing=0;fontSize=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="2070" width="1510" height="40" as="geometry"/></mxCell><mxCell id="limits" value="&lt;b&gt;保留与实现边界&lt;/b&gt;&lt;br&gt;人格、关系、独立信号/回执日志不由memory/reset清理；重置范围不是整个角色重建。&lt;br&gt;当前接口先清会话再清长期记忆，可能部分失败；新屏障、事务和取消字段为待协议化目标。&lt;br&gt;屏障提交成功 ≠ 全部物理清理完成；每一步如实报告，失败重试沿用原作用域和操作身份。&lt;br&gt;来源：UC-07，M3/M4/C1/C3，BR-DEP-06，AT-EVO-08。实线=请求，虚线消息=返回；生命线虚线仅表示时间延续。" style="fontFamily=Microsoft YaHei;fontColor=#172235;html=1;whiteSpace=wrap;fontSize=20;rounded=0;strokeColor=#64748b;strokeWidth=1.4;fillColor=#ffffff;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=19;" vertex="1" parent="1"><mxGeometry x="45" y="2260" width="1850" height="200" as="geometry"/></mxCell><mxCell id="physical_fail" value="长期清理错误；新屏障仍有效" style="html=1;fontFamily=Microsoft YaHei;fontSize=19;strokeColor=#475569;strokeWidth=1.5;endArrow=open;endFill=0;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1750" y="1660" as="sourcePoint"/><mxPoint x="910" y="1660" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>