@startuml 10-player-use-cases-as-is

' Model: As-Is
' UE baseline: dead903156946ec6956342f02d587612baab1717
' AI service baseline: f548c1ad64c5d284eace084132616d171d45403f
' Evidence: UE-PLAYER-001, UE-PLAYER-BP-RUNTIME-001,
'           UE-INPUT-IMC-COMBAT-001, UE-INPUT-IMC-LOCOMOTION-001,
'           UE-INPUT-LIGHT-001, UE-INPUT-HEAVY-001,
'           UE-INPUT-LOCKON-001, UE-INPUT-EVADE-001,
'           UE-INPUT-CHAT-001, UE-VOICE-BP-FLOW-001,
'           UE-CMD-BP-VOICE-001, UE-CHAT-BP-001,
'           UE-HUD-BP-001, UE-ENEMY-HUD-BP-001,
'           UE-LOCKON-HUD-BP-001, UE-RESULT-HUD-BP-001,
'           UE-RESULT-HUD-BP-RESTART-001, UE-MATCH-001,
'           UE-CHAT-001, UE-CMD-001, PY-API-CHAT-001,
'           PY-API-VOICE-001

title 玩家当前可用功能用例（As-Is）

left to right direction

skinparam backgroundColor #FAFAF7
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam actor {
  BackgroundColor #F8E7C4
  BorderColor #8A5A20
  FontColor #3F2A12
}
skinparam usecase {
  BackgroundColor #E8F0FE
  BorderColor #315A93
  FontColor #172554
}
skinparam rectangle {
  BackgroundColor #F7F8FA
  BorderColor #64748B
  FontColor #1E293B
}
skinparam note {
  BackgroundColor #FFF8DB
  BorderColor #9A7B16
  FontColor #3F3308
}

actor "玩家" as User
actor "Python AI 服务" as PythonService <<supporting system>>

rectangle "Aesir Combat Prototype\nUnreal Engine 客户端" as Game {
  package "角色操控" {
    usecase "移动角色" as UC_Move
    usecase "控制视角" as UC_Look
    usecase "锁定 / 解除锁定敌人" as UC_LockOn
    usecase "闪避" as UC_Evade
  }

  package "近战战斗" {
    usecase "执行近战攻击" as UC_Attack
    usecase "轻攻击" as UC_LightAttack
    usecase "重攻击" as UC_HeavyAttack
  }

  package "战斗反馈" {
    usecase "查看玩家生命值" as UC_PlayerHealth
    usecase "查看敌人生命值" as UC_EnemyHealth
    usecase "查看锁定标记" as UC_LockIndicator
    usecase "查看战斗结果" as UC_Result
    usecase "重新开始战斗" as UC_Restart
  }

  package "Alice 交互" {
    usecase "打开 / 关闭陪伴聊天" as UC_ToggleChat
    usecase "发送文本聊天" as UC_TextChat
    usecase "查看 Alice 文本回复" as UC_TextReply
    usecase "录制语音命令" as UC_RecordVoice
    usecase "提交语音命令解析" as UC_ParseVoice
    usecase "查看命令解析结果" as UC_ParseResult
  }
}

User --> UC_Move
User --> UC_Look
User --> UC_LockOn
User --> UC_Evade
User --> UC_Attack
User --> UC_PlayerHealth
User --> UC_EnemyHealth
User --> UC_LockIndicator
User --> UC_Result
User --> UC_ToggleChat
User --> UC_TextChat
User --> UC_RecordVoice

UC_LightAttack -|> UC_Attack
UC_HeavyAttack -|> UC_Attack

UC_TextChat ..> UC_TextReply : <<include>>
UC_RecordVoice ..> UC_ParseVoice : <<include>>
UC_ParseVoice ..> UC_ParseResult : <<include>>
UC_Restart ..> UC_Result : <<extend>>\n[战斗已经结束]

PythonService --> UC_TextChat : `/v1/companion/chat`
PythonService --> UC_ParseVoice : `/v1/voice/command`

note right of UC_Attack
  玩家输入绑定到 Light / Heavy Action；
  实际攻击由 CombatComponent 播放 Montage，
  并在 AttackWindow 内完成命中结算。
end note

note right of UC_Evade
  当前玩家代码支持 Dash / Roll，
  并在动画 Notify 窗口内设置无敌状态。
end note

note bottom of UC_ParseResult
  当前已核验链路到 ParseVoiceCommand 与
  OnCommandParsed 返回为止。

  尚未发现 TryAcceptOrder，也没有 Alice
  技能执行接线，所以这里不包含“执行战术命令”用例。
end note

note bottom of UC_TextChat
  文本聊天与战术命令是两个不同用例：
  WBP_CompanionChatTest 当前只调用
  CompanionChatSubsystem。
end note

note bottom of UC_Restart
  当前结果界面重载 L_AesirCombatTest，
  尚未形成主菜单、存档或检查点流程。
end note

legend bottom
  |= 符号 |= 含义 |
  | 实线关联 | Actor 当前能够参与的用例 |
  | <<include>> | 当前用例必然调用的子用例 |
  | <<extend>> | 满足括号条件时可发生的扩展用例 |
  | 空缺用例 | 尚未实现，不属于本 As-Is 图 |
endlegend

@enduml
