;br&gt;接收 NPC 自主行为" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;ellipse;fillColor=#ffffff;align=center;fontSize=20;" vertex="1" parent="boundary"><mxGeometry as="geometry" x="160" y="486" width="440" height="84"></mxGeometry></mxCell><mxCell id="ue_uc4" value="" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" parent="1" source="ue" target="uc4"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="uc5" value="&lt;b&gt;UC-05&lt;/b&gt;&lt;br&gt;上报世界事件并获得反应" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;ellipse;fillColor=#ffffff;align=center;fontSize=20;" vertex="1" parent="boundary"><mxGeometry as="geometry" x="160" y="618" width="440" height="84"></mxGeometry></mxCell><mxCell id="ue_uc5" value="" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" parent="1" source="ue" target="uc5"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="uc6" value="&lt;b&gt;UC-06&lt;/b&gt;&lt;br&gt;查询状态与决策解释" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;ellipse;fillColor=#ffffff;align=center;fontSize=20;" vertex="1" parent="boundary"><mxGeometry as="geometry" x="160" y="750" width="440" height="84"></mxGeometry></mxCell><mxCell id="ue_uc6" value="" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" parent="1" source="ue" target="uc6"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="uc7" value="&lt;b&gt;UC-07&lt;/b&gt;&lt;br&gt;重置 NPC 记忆" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;ellipse;fillColor=#ffffff;align=center;fontSize=20;" vertex="1" parent="boundary"><mxGeometry as="geometry" x="160" y="882" width="440" height="84"></mxGeometry></mxCell><mxCell id="ue_uc7" value="" style="html=1;rounded=0;curved=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172235;strokeColor=#475569;strokeWidth=1.6;endArrow=none;endFill=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.65;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" parent="1" source="ue" target="uc7"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="player_note" value="&lt;b&gt;玩家 A-01&lt;/b&gt; 是UC-01～04的目标属主；游戏输入经UE提交。&lt;br&gt;UC-06/07也可由本机调试工具调用，图不表示UE已制作对应按钮。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="190" width="300" height="175"></mxGeometry></mxCell><mxCell id="llm_note" value="&lt;b&gt;可选协作&lt;/b&gt;&lt;br&gt;LLM不可用时按具体链路降级。&lt;br&gt;本地ASR作为内部组件，不另画必选参与者。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1170" y="640" width="290" height="155"></mxGeometry></mxCell><mxCell id="scope_note" value="&lt;b&gt;交互边界&lt;/b&gt;&lt;br&gt;自主行为由UE心跳拉取，不主动推送。&lt;br&gt;建议可被UE拒绝；收到建议不表示完成执行。&lt;br&gt;调试查询/重置是服务交互，非玩家战斗能力。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1170" y="870" width="290" height="215"></mxGeometry></mxCell><mxCell id="footer" value="来源：SDD v1.1 REQ-01～08、UC-01～07、BR-01/08。没有业务证据时不增设include/extend。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#172235;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1250" width="1420" height="45"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>