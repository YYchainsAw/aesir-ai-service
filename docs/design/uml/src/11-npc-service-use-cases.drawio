<mxfile host="Electron" version="29.6.1" type="device" compressed="false"><diagram id="use-cases" name="服务用例"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1330" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0"></mxCell><mxCell id="1" parent="0"></mxCell><mxCell id="title" value="UML-11  NPC 服务用例" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#172235;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1420" height="50"></mxGeometry></mxCell><mxCell id="subtitle" value="系统边界：Python NPC 服务｜UC-01～07完整保留；REQ-08角色隔离贯穿全部适用交互。分析目标不等于已验收。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#48566a;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1420" height="66"></mxGeometry></mxCell><mxCell id="boundary" value="Aesir AI Service · NPC子系统" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;swimlane;startSize=48;horizontal=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;container=1;pointerEvents=0;align=center;fontStyle=1;fontSize=22;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="170" width="740" height="1040"></mxGeometry></mxCell><mxCell id="ue" value="游戏/调试客户端&lt;br&gt;A-02&lt;br&gt;游戏世界由UE裁定" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172235;strokeColor=#475569;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#ffffff;fontSize=20;" vertex="1" p