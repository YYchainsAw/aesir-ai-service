# Template only. Store the actual file at /etc/aesir-ai/service.env (mode 0600).
# Blank LLM values intentionally block the production preflight.
AESIR_SERVICE_HOST=127.0.0.1
AESIR_SERVICE_PORT=8011
AESIR_GAME_ID=aesir
AESIR_SCOPE_IDENTITY_BACKEND=bearer
AESIR_SCOPE_LEGACY_ENABLED=false
AESIR_SCOPE_STORAGE_BACKEND=sql
AESIR_SCOPE_DATABASE_URL_FILE=/etc/aesir-ai/database.url
AESIR_COORDINATION_BACKEND=redis
AESIR_COORDINATION_REDIS_URL=redis://127.0.0.1:6379/0

AESIR_PARSER_BACKEND=rule
AESIR_INTENT_BACKEND=rule
AESIR_COMPANION_BACKEND=llm
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

AESIR_ASR_BACKEND=faster_whisper
AESIR_ASR_MODEL=/opt/aesir-ai/models/whisper-small
AESIR_ASR_DEVICE=cpu
AESIR_ASR_COMPUTE_TYPE=int8
AESIR_ASR_LANGUAGE=zh
AESIR_ASR_MAX_AUDIO_BYTES=2097152
AESIR_ASR_MAX_AUDIO_SECONDS=30

AESIR_MEMORY_ROOT=/var/lib/aesir-ai/memory
AESIR_RELATIONSHIP_ROOT=/var/lib/aesir-ai/relationship
AESIR_RECEIPTS_DIR=/var/lib/aesir-ai/signals/executions
AESIR_DIALOGUE_SIGNALS_DIR=/var/lib/aesir-ai/signals/dialogue
AESIR_AGENT_STEPS_DIR=/var/lib/aesir-ai/signals/agent_steps
AESIR_EVENT_SIGNALS_DIR=/var/lib/aesir-ai/signals/events
AESIR_REQUEST_TRACES_DIR=/var/lib/aesir-ai/signals/request_traces
