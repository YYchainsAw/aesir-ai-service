# 复制为 .env 并按需填写。所有项都有安全默认值，缺省也能直接运行。

# ---- 服务监听（FIX-01 / FIX-10：统一 Python 与 UE 口径） ----
# 当前为单一服务架构，UE 的聊天子系统与指令子系统应指向同一地址。
# 默认值 127.0.0.1:8011（与 UE CommandServiceSubsystem / CompanionChatSubsystem 代码默认值对齐，UE 侧零改动）。
AESIR_SERVICE_HOST=127.0.0.1
AESIR_SERVICE_PORT=8011

# ---- 游戏档案（S3：一进程一游戏） ----
# 当前进程服务的游戏：决定加载 data/games/<game_id>/capability.yaml，
# 人格注册表限制在 data/personas/<game_id>/ 之下（跨游戏角色返回 404）。
# 多游戏并存时按游戏各起一个实例并配不同 AESIR_SERVICE_PORT。
# 可选值见 data/games/ 目录（自带 aesir / demo-vn 两个样例）。
AESIR_GAME_ID=aesir

# 命令解析后端：rule（默认，规则解析）/ llm（LLM API，识别不了时回退到规则）
AESIR_PARSER_BACKEND=rule

# 陪伴对话后端：mock（默认，固定回复）/ llm（使用共享 LLM Client）
AESIR_COMPANION_BACKEND=mock

# 语音转写后端：mock（默认，返回 AESIR_ASR_MOCK_TEXT）/ faster_whisper（真实本机 Whisper）
AESIR_ASR_BACKEND=mock
# mock 转写返回的固定命令文本；留空 = 未转出（下游 recognized:false）
# AESIR_ASR_MOCK_TEXT=艾莉，撤退并优先保命

# ---- faster-whisper 真机转写（仅当 AESIR_ASR_BACKEND=faster_whisper 时生效）----
# 模型首次使用按需下载；国内网络需先设 HF_ENDPOINT=https://hf-mirror.com
# AESIR_ASR_MODEL=small           # 8GB 显存推荐；base 更快、medium 更准
# AESIR_ASR_DEVICE=auto           # auto：有 CUDA 用 GPU，否则 CPU
# AESIR_ASR_COMPUTE_TYPE=int8_float16   # CUDA 加速；CPU 自动退化为 int8
# AESIR_ASR_LANGUAGE=zh           # 跳过语言检测，加快转写

# ---- LLM Provider（仅当任一后端设为 llm 时填写；OpenAI 兼容 /chat/completions） ----
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=15

# ---- 国内网络镜像（下载 HuggingFace 模型时启用） ----
# HF_ENDPOINT=https://hf-mirror.com

# ---- v0.4 身份与兼容（单 worker；开发身份不能代替生产认证）----
# disabled（默认）拒绝新版业务直到配置可信身份；本地开发可选 development。
AESIR_SCOPE_IDENTITY_BACKEND=disabled
# AESIR_SCOPE_DEV_PLAYER_ID=77777777-7777-4777-8777-777777777777
# AESIR_SCOPE_DEV_SAVE_IDS=["22222222-2222-4222-8222-222222222222"]
# 仅需要旧协议开发回归时显式打开；关闭后旧业务/SSE/语音/console入口403。
AESIR_SCOPE_LEGACY_ENABLED=false
