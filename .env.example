# 复制为 .env 并按需填写。所有项都有安全默认值，缺省也能直接运行。

# 命令解析后端：rule（默认，规则解析）/ llm（LLM API，识别不了时回退到规则）
AESIR_PARSER_BACKEND=rule

# ---- LLM（DeepSeek，OpenAI 兼容。切换 Qwen/Ark 只需改 base_url/model）----
# 启用 AESIR_PARSER_BACKEND=llm 时必须填 LLM_API_KEY
# LLM_API_KEY=sk-xxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ---- 国内网络镜像（下载 HuggingFace 模型时启用） ----
# HF_ENDPOINT=https://hf-mirror.com